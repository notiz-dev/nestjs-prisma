// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?
}
